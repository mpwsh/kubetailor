{{!--
  The Domains step, optional: only an HTTP port (Network step) is reached through a domain.
  The shared subdomain lands under the API's base domain (`config.baseDomain`, which the server
  gets from its own configuration — on flint, the `base_domain` overlay variable); a custom
  domain must point at the cluster's address yourself.
--}}
<div x-data="{ shared: '{{tapp.domains.shared}}' }" class="flex w-full max-w-lg flex-col gap-1 text-neutral-600 dark:text-neutral-300">
    <label for="sharedInput" class="w-fit pl-0.5 text-sm">Shared subdomain</label>
    <div class="flex items-stretch">
        <input id="sharedInput" name="shared" type="text" x-model="shared" placeholder="my-app" autocomplete="off"
               class="w-full rounded-l-md border border-neutral-300 bg-neutral-50 px-2 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:border-neutral-700 dark:bg-neutral-900/50 dark:focus-visible:outline-white"/>
        <span class="flex items-center whitespace-nowrap rounded-r-md border border-l-0 border-neutral-300 bg-neutral-100 px-3 text-sm text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400">
            {{#if config.baseDomain}}.{{config.baseDomain}}{{else}}.(base domain unknown){{/if}}
        </span>
    </div>
    <p class="pl-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        <span x-show="shared.trim() === ''">Optional. Leave empty for an app reached by IP only (TCP/UDP ports exposed at the node).</span>
        <span x-show="shared.trim() !== ''" x-cloak>Your HTTP port will answer at
            <code x-text="`https://${shared.trim().toLowerCase()}{{#if config.baseDomain}}.{{config.baseDomain}}{{/if}}`"></code>,
            with a certificate issued on first request.</span>
    </p>
</div>

{{> cmp/text-input
  name = "custom"
  title = "Custom domain"
  placeholder = "www.example.com"
  value = tapp.domains.custom
  help = "Optional. Point its DNS at the cluster's address first; the certificate follows once it resolves."
}}
