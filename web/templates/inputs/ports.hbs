{{!--
  The Network step: every port the app listens on, and the group it belongs to.

  Rows live in Alpine state seeded by the server (`port_rows`: the HTTP port first, then the
  others; a new deployment starts with HTTP on 80). Each row posts a port_number /
  port_protocol / port_expose triple; the server folds HTTP into `container.port` (the one the
  domains route to) and the rest into `container.ports`. A row without a number is ignored.

  Exposure, as the API defines it:
    node      hostPort on the node's public IP, same port number (one instance per node)
    nodePort  NodePort service, port number assigned by Kubernetes
    cluster   reachable from other apps in the cluster only
  HTTP has none of its own: it is reached through the domains, over HTTPS.
--}}
<div x-data="{ ports: {{{json port_rows}}}, max: {{max_ports}} }" class="flex flex-col gap-2 text-neutral-600 dark:text-neutral-300">
    <div class="flex items-baseline justify-between">
        <span class="pl-0.5 text-sm font-medium text-neutral-900 dark:text-white">Ports</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400" x-text="`${ports.length} / ${max}`"></span>
    </div>
    <p class="pl-0.5 text-xs text-neutral-500 dark:text-neutral-400">
      HTTP is reached through your domains over HTTPS (one per deployment). TCP and UDP ports
      exposed at the <em>node</em> answer on the node's public IP; open them on the cluster
      firewall.
    </p>

    <template x-for="(p, i) in ports" :key="i">
        <div class="flex flex-wrap items-center gap-2">
            <input type="text" inputmode="numeric" pattern="[0-9]*"
                   name="port_number" x-model="p.port" placeholder="port" aria-label="port number"
                   class="w-24 rounded-md border border-neutral-300 bg-neutral-50 px-2 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:border-neutral-700 dark:bg-neutral-900/50 dark:focus-visible:outline-white"/>
            <select name="port_protocol" x-model="p.protocol" aria-label="protocol"
                    class="rounded-md border border-neutral-300 bg-neutral-50 px-2 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:border-neutral-700 dark:bg-neutral-900/50 dark:focus-visible:outline-white">
                <option value="HTTP">HTTP</option>
                <option value="TCP">TCP</option>
                <option value="UDP">UDP</option>
            </select>
            {{!-- Hidden (not disabled) for HTTP so every row still posts its triple. --}}
            <select name="port_expose" x-model="p.expose" aria-label="exposure" x-show="p.protocol !== 'HTTP'"
                    class="rounded-md border border-neutral-300 bg-neutral-50 px-2 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:border-neutral-700 dark:bg-neutral-900/50 dark:focus-visible:outline-white">
                <option value="node">Public, same port (node)</option>
                <option value="nodePort">Public, assigned port (nodePort)</option>
                <option value="cluster">Cluster only</option>
            </select>
            <span x-show="p.protocol === 'HTTP'" class="px-1 text-sm text-neutral-500 dark:text-neutral-400">via your domains (HTTPS)</span>
            <button type="button" @click="ports.splice(i, 1)" aria-label="remove port"
                    class="rounded-md border border-neutral-300 px-2.5 py-2 text-sm hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:border-neutral-700 dark:focus-visible:outline-white">
                <i class="fas fa-trash" aria-hidden="true"></i>
            </button>
        </div>
    </template>

    <button type="button" @click="ports.push({ port: '', protocol: 'TCP', expose: 'node' })"
            :disabled="ports.length >= max"
            class="w-fit rounded-md border border-neutral-300 bg-neutral-50 px-3 py-1.5 text-sm hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black disabled:cursor-not-allowed disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:focus-visible:outline-white">
        + Add port
    </button>
</div>

{{> cmp/text-input
  name = "group"
  title = "Group"
  placeholder = "optional"
  value = tapp.group
  help = "Your deployments in the same group can reach each other inside the cluster (by service name); across groups they cannot."
}}
