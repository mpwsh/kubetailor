{{!-- The Environment step: plain variables and secrets, both injected as env vars. --}}
{{> cmp/repeater
  prefix = "env"
  title = "Variables"
  help = "Environment variables for the container."
  key_placeholder = "LOG_LEVEL"
  value_placeholder = "info"
  add_label = "Add variable"
  seed = tapp.env
}}

{{> cmp/repeater
  prefix = "secret"
  title = "Secrets"
  help = "Also environment variables, but stored as a Kubernetes Secret."
  key_placeholder = "DATABASE_URL"
  value_placeholder = "value"
  add_label = "Add secret"
  seed = tapp.secrets
  kind = "secret"
}}
