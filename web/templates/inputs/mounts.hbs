{{!-- The Data step: persistent volumes and files written into the container. --}}
{{> cmp/repeater
  prefix = "volume"
  title = "Volumes"
  help = "Persistent storage on the app's node, mounted into the container. The data survives restarts and redeploys."
  key_placeholder = "/data"
  value_placeholder = (default config.limits.volume.size.max "1Gi")
  add_label = "Add volume"
  seed = tapp.container.volumes
}}
{{#if config.limits.volume.size.max}}
<p class="-mt-4 pl-0.5 text-xs text-neutral-500 dark:text-neutral-400">
  Up to {{config.limits.volume.size.max}} each{{#if config.limits.volume.count.max}}, {{config.limits.volume.count.max}} per deployment{{/if}}.
</p>
{{/if}}

{{> cmp/repeater
  prefix = "file"
  title = "Files"
  help = "Written into the container at that path before it starts: configuration, certificates, scripts."
  key_placeholder = "/etc/app/config.toml"
  value_placeholder = "contents"
  add_label = "Add file"
  seed = tapp.container.files
  kind = "textarea"
}}
