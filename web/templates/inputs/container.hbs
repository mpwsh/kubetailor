{{!--
  Image and instance count: shared by the Docker and Git sources, rendered once so each form
  field exists once. Ports are the Network step's business.
--}}
<div class="space-y-4">
{{> cmp/text-input
  name = "image"
  title = "Image"
  placeholder = "repository/image:tag"
  value = tapp.container.image
}}
<p x-show="source === 'Git'" x-cloak class="-mt-2 pl-0.5 text-xs text-neutral-500 dark:text-neutral-400">
  Base image your source is built and run in (node, python, rust, …).
</p>

{{> cmp/number-input
  name="replicas"
  title="Instances"
  value=tapp.container.replicas
  init=1
  min=1
  max=10
}}
</div>
