{{!-- One line of a progress checklist. Params: done (bool), label, pending --}}
<div class="flex items-center gap-3 rounded-md border border-neutral-300 px-4 py-3 dark:border-neutral-700">
    {{#if done}}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 shrink-0 text-green-600 dark:text-green-400" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
    </svg>
    <span class="text-sm text-neutral-900 dark:text-white">{{label}}</span>
    {{else}}
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5 shrink-0 animate-spin motion-reduce:animate-none fill-neutral-500">
        <path opacity="0.25" d="M12,1A11,11,0,1,0,23,12,11,0,0,0,12,1Zm0,19a8,8,0,1,1,8-8A8,8,0,0,1,12,20Z" />
        <path d="M10.14,1.16a11,11,0,0,0-9,8.92A1.59,1.59,0,0,0,2.46,12,1.52,1.52,0,0,0,4.11,10.7a8,8,0,0,1,6.66-6.61A1.42,1.42,0,0,0,12,2.69h0A1.57,1.57,0,0,0,10.14,1.16Z" />
    </svg>
    <span class="text-sm text-neutral-600 dark:text-neutral-300">{{#if label}}{{label}} — {{/if}}{{pending}}</span>
    {{/if}}
</div>
