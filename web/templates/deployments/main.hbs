{{> top}}
<div class="flex items-center justify-end gap-2 pb-2 text-sm text-neutral-600 dark:text-neutral-300">
    {{!--
      The checkbox lives outside the table so it survives every refresh; the table's trigger
      reads it on each tick (conditional polling), which is how htmx pauses a poller.
    --}}
    <label for="autorefresh" class="inline-flex items-center gap-2 cursor-pointer select-none">
        <input type="checkbox" id="autorefresh" checked class="size-4 rounded border-neutral-300 dark:border-neutral-700">
        Auto-refresh
    </label>
    <svg id="table-refresh-indicator" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="htmx-indicator size-4 animate-spin motion-reduce:animate-none fill-neutral-500">
        <path opacity="0.25" d="M12,1A11,11,0,1,0,23,12,11,0,0,0,12,1Zm0,19a8,8,0,1,1,8-8A8,8,0,0,1,12,20Z" />
        <path d="M10.14,1.16a11,11,0,0,0-9,8.92A1.59,1.59,0,0,0,2.46,12,1.52,1.52,0,0,0,4.11,10.7a8,8,0,0,1,6.66-6.61A1.42,1.42,0,0,0,12,2.69h0A1.57,1.57,0,0,0,10.14,1.16Z" />
    </svg>
</div>
{{> deployments/table}}
