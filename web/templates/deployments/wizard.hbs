{{!--
  Six steps; every step's inputs stay in the DOM (x-show), so the form always posts the whole
  deployment. Nothing here needs JavaScript beyond Alpine: the repeaters are Alpine state, the
  submit button is the top bar's (form="editForm"), htmx posts the form.
--}}
<div class="space-y-8">
<div x-show="currentStep === 1" class="space-y-6">
  {{> cmp/custom-radio
      columns=2
      group="editor"
      items=[
        {"title": "Wizard", "description": "Deploy using the step-by-step UI", "icon": "fa-solid fa-hat-wizard", "checked": true},
        {"title": "Manifest", "description": "Deploy from text editor", "icon": "fa-solid fa-code"}
      ]
  }}
</div>

<div x-show="editor === 'Wizard'" class="space-y-6">
  {{> cmp/steps }}

  {{!-- 1 Basic --}}
  <div x-show="currentStep === 1" class="space-y-4">
    {{> cmp/text-input
      name = "name"
      title = "Name"
      placeholder = "my-app"
      value = tapp.name
      help = "Lowercase letters, digits and dashes. It names everything the deployment creates."
    }}
    {{> cmp/text-input
      name = "region"
      title = "Region"
      placeholder = "any"
      value = tapp.region
      help = "Pin the app to the nodes of one region (e.g. scl). Leave empty to let the scheduler choose."
    }}
  </div>

  {{!-- 2 Source --}}
  <div x-show="currentStep === 2" class="space-y-6">
    {{> cmp/custom-radio
      columns=2
      group="source"
      items=[
        {"title": "Docker", "description": "Image from docker hub", "icon": "fa-brands fa-docker", "checked": true},
        {"title": "Git", "description": "Any Git repository", "icon": "fa-solid fa-code-branch"}
      ]
    }}
    <div class="mt-4">{{> inputs/container}}</div>
    <div x-show="source === 'Git'" x-cloak class="mt-4 space-y-4">{{> inputs/git}}</div>
  </div>

  {{!-- 3 Network --}}
  <div x-show="currentStep === 3" class="space-y-6">
    {{> inputs/ports}}
  </div>

  {{!-- 4 Domains --}}
  <div x-show="currentStep === 4" class="space-y-6">
    {{> inputs/domain}}
  </div>

  {{!-- 5 Data --}}
  <div x-show="currentStep === 5" class="space-y-6">
    {{> inputs/mounts}}
  </div>

  {{!-- 6 Environment --}}
  <div x-show="currentStep === 6" class="space-y-6">
    {{> inputs/environment}}
  </div>

  {{!-- Navigation --}}
  <div class="flex justify-between mt-4">
    <a href="{{return_url}}" hx-get="{{return_url}}" hx-target="#content" hx-push-url="true" hx-indicator="#nav-indicator" x-show="currentStep <= 1">
      {{> cmp/button-secondary title="Cancel"}}
    </a>
    <a x-show="currentStep > 1"
      @click="currentStep--">
      {{> cmp/button-secondary title="Previous"}}
      </a>

    <a
      x-show="currentStep < steps.length"
      @click="currentStep++"
      {{> cmp/button-primary title="Next"}}
    </a>
    {{!--
      Last step: post the whole form to the review endpoint. A validation problem is a 422 into
      #form-errors and we stay here; otherwise the fragment lands in #review and its event
      shows it instead of the wizard.
    --}}
    <button type="button"
            x-show="currentStep === steps.length"
            hx-post="/deployments/review"
            hx-vals='{"intent": "{{action.name}}"}'
            hx-target="#review"
            hx-swap="innerHTML"
            hx-status:422="target:#form-errors swap:innerHTML"
            hx-indicator="#form-indicator"
            hx-disable="this"
            class="cursor-pointer whitespace-nowrap rounded-md bg-black px-4 py-2 text-sm font-medium tracking-wide text-neutral-100 transition hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black disabled:cursor-not-allowed disabled:opacity-75 dark:bg-white dark:text-black dark:focus-visible:outline-white">
      Review &amp; {{action.name}}
    </button>
  </div>
</div>
</div>
