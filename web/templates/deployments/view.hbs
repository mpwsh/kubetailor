{{> top }}
<div class="form-group">
  <span class="subtitle no-select">Name:</span>
  <div class="subtitle-white">{{tapp.name}}</div>
</div>
<div class="form-group">
  <span class="subtitle no-select">Image:</span>
  <div class="subtitle-white">{{tapp.container.image}}</div>
</div>
<div class="form-group">
  <span class="subtitle no-select">HTTP port:</span>
  <div class="subtitle-white">{{#if tapp.container.port}}{{tapp.container.port}}{{else}}none{{/if}}</div>
</div>
{{#if tapp.container.ports}}
<div class="form-group">
  <span class="subtitle no-select">Other ports:</span>
  {{#each tapp.container.ports}}
    <div class="subtitle-white">{{port}}/{{protocol}} — {{expose}}</div>
  {{/each}}
</div>
{{/if}}
<div class="form-group">
  <span class="subtitle no-select">Region:</span>
  <div class="subtitle-white">{{#if tapp.region}}{{tapp.region}}{{else}}any{{/if}}</div>
</div>
<div class="form-group">
  <span class="subtitle no-select">Shared Domain:</span>
  <div class="subtitle-white">
    {{tapp.domains.shared}} |  <a href="https://{{tapp.domains.shared}}" target="_blank">Visit site</a>
  </div>
</div>
<div class="form-group">
  <span class="subtitle no-select">Custom Domain:</span>
  <div class="subtitle-white">
    {{#if tapp.domains.custom}}
      {{tapp.domains.custom}}
    {{else}}
      N/A
    {{/if}}
  </div>
</div>
<div class="form-group">
  <span class="subtitle no-select">Environment Variables:</span>
  <div id="key-value-pairs">
    {{#each tapp.config}}
      <div class="form-group-inline key-value-group">
        <div class="subtitle-white">{{@key}}: {{this}}</div>
      </div>
    {{/each}}
  </div>
</div>
